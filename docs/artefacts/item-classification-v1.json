{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.bindle.example/contracts/item-classification/v1",
  "title": "Item classification v1",
  "description": "The item-classification/v1 contract of docs/spec/extensions/item-classification.md (draft, provisional, unsigned). Scores one item (text, bounded caller hints and optionally one inline media object) against a taxonomy the caller supplies with every call. The provider hard-codes no categories. Validates the contract method/args projection of a Bindle RPC envelope; the resource applies every rule of the specification (UTF-8 byte bounds, control-character refusal, one score per supplied label, no retention of item content, labels or scores).",
  "type": "object",
  "required": [
    "method",
    "args"
  ],
  "properties": {
    "method": {
      "const": "classify"
    },
    "args": {
      "$ref": "#/$defs/classifyArgs"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "classifyArgs": {
      "type": "object",
      "required": [
        "item",
        "labels"
      ],
      "properties": {
        "item": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "media"
              ]
            }
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "hints": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            },
            "media": {
              "type": "object",
              "required": [
                "type",
                "data"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "pattern": "^[a-z]{1,20}/[a-z0-9][a-z0-9.+-]{0,99}$"
                },
                "data": {
                  "type": "string",
                  "maxLength": 349526,
                  "pattern": "^[A-Za-z0-9_-]*$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "classifyResult": {
      "type": "object",
      "required": [
        "scores",
        "model"
      ],
      "properties": {
        "scores": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "model": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  "x-methods": {
    "classify": {
      "request": "#",
      "result": "#/$defs/classifyResult",
      "effect": "write",
      "permission": "Exact classify grant on an owner-assigned resource. Each call may debit the owner's paid classification allowance; item content, labels and scores are never retained."
    }
  }
}
