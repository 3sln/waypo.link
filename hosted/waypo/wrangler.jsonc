// Native capacity and work-policy numbers are closed engineering examples only, not financially safe defaults.
// Finite rate buckets do not provide a period wallet or cover raw inbound Worker billing.
// Operators must explicitly review and replace all limits before any activation.
{
  "name": "waypo-link-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "durable_objects": {"bindings": [{"name": "INSTALLATION", "class_name": "HostedInstallation"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["HostedInstallation"]}],
  "r2_buckets": [{"binding": "PRIVATE_OBJECTS", "bucket_name": "operator-configured-private-waypo-preview"}],
  "assets": {"directory": "./node_modules/@3sln/waypo/.output/worker-assets", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "WAYPO_PREVIEW_ENABLED": "false",
    "WAYPO_CONFIG": "{\"installationId\":\"waypo-link-preview\",\"name\":\"Waypo.link\",\"issuer\":\"https://waypo.link/api/auth\",\"adminUrl\":\"https://waypo.link/manage/\",\"admission\":\"closed\",\"nativeCredentials\":{\"revision\":\"engineering-example-v1\",\"installationAccessRows\":65536,\"installationRefreshRows\":65536,\"installationFamilies\":65536,\"accountAccessRows\":64,\"accountRefreshRows\":64,\"clientAccessRows\":64,\"clientRefreshRows\":64,\"accountFamilies\":32,\"clientFamilies\":32,\"retryMs\":60000},\"nativeRetainedLimits\":{\"sessionInstallation\":65536,\"sessionOwner\":64,\"keyInstallation\":65536,\"keyOwner\":32},\"nativeStorageCapacity\":{\"maxBytes\":100000000,\"headroomBytes\":8000000,\"retryMs\":1000},\"sessionSecurity\":{\"enabled\":true,\"revision\":\"engineering-example-v1\",\"maxOwners\":128,\"reviewBytes\":16384,\"proofBytes\":2048,\"humanBytes\":2048,\"mailPolicy\":{\"owner\":{\"maxSends\":6,\"windowMs\":600000,\"cooldownMs\":60000},\"review\":{\"maxSends\":3,\"minResendMs\":60000,\"maxCodeAttempts\":8}}},\"tokenWork\":{\"revision\":\"engineering-example-work-v1\",\"reservationUnits\":16,\"costs\":{\"lookup\":1,\"refresh\":1},\"maxFamilies\":16,\"inactiveFamilyMs\":600000,\"lookup\":{\"capacity\":64,\"refillPerMinute\":16},\"account\":{\"capacity\":32,\"refillPerMinute\":4},\"family\":{\"capacity\":8,\"refillPerMinute\":1},\"fleet\":{\"capacity\":64,\"refillPerMinute\":8}},\"services\":{\"workBudget\":{\"revision\":\"engineering-example-work-v1\",\"reservationUnits\":16,\"costs\":{\"storage-read\":1,\"storage-write\":1,\"notifications-read\":1,\"notifications-write\":1,\"signaling-read\":1,\"signaling-write\":1,\"subscription-open\":1},\"account\":{\"capacity\":256,\"refillPerMinute\":16},\"app\":{\"capacity\":256,\"refillPerMinute\":16},\"fleet\":{\"capacity\":1024,\"refillPerMinute\":64},\"ingress\":{\"capacity\":256,\"refillPerMinute\":16},\"maxActiveApps\":16,\"inactiveAppMs\":600000}}}",
    "HOSTED_FREE_CONFIG": "{\"mode\":\"free\",\"environment\":\"production\",\"freeStorageBytes\":500000000,\"accountAdmission\":{\"revision\":1,\"maxPublicAccounts\":1,\"maxProtectedAccounts\":48,\"acceptingNewAccounts\":false},\"executeRetention\":false,\"allowedSignupCountries\":[],\"accountCreationRate\":{\"revision\":1,\"global\":{\"capacity\":4,\"refillPerMinute\":1},\"public\":{\"capacity\":2,\"refillPerMinute\":1},\"protected\":{\"capacity\":2,\"refillPerMinute\":1},\"protectedReserveUnits\":2,\"blockSize\":1,\"blockMs\":60000,\"maxWorkers\":4,\"protectedWorkerSlots\":1}}"
  }
}
